<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2015/06/nuspec.xsd">
  <metadata>
    <id>hetzer</id>
    <version>0.3.0</version>
    <packageSourceUrl>https://github.com/agunggnn/hetzer</packageSourceUrl>
    <owners>agunggnn</owners>
    <title>Hetzer CLI</title>
    <authors>agunggnn</authors>
    <projectUrl>https://github.com/agunggnn/hetzer</projectUrl>
    <licenseUrl>https://github.com/agunggnn/hetzer/blob/main/LICENSE</licenseUrl>
    <requireLicenseAcceptance>false</requireLicenseAcceptance>
    <tags>hetzer ai-security secret-vault mcp zero-plaintext token-sniffer</tags>
    <summary>Zero-Plaintext Armor and Secret Interceptor for AI Agents.</summary>
    <description>
      Hetzer is a local-first zero-plaintext security armor and secret interceptor for AI agents.
      Features sub-2ms DFA Secret Sniffer, AES-256-GCM Grimoire Vault, Git pre-commit guard, and Universal Agent Skills for Hermes, AGY, OpenCode, Cursor, and Claude.
    </description>
    <dependencies>
      <dependency id="nodejs" version="22.5.0" />
    </dependencies>
  </metadata>
  <files>
    <file src="tools\**" target="tools" />
  </files>
</package>
