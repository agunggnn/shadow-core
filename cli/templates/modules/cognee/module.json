{
  "schemaVersion": 1,
  "id": "cognee",
  "label": "Cognee Memory",
  "version": "1",
  "profile": "cognee",
  "lifecycle": "compose",
  "surface": "headless",
  "defaultEnabled": false,
  "requires": ["core"],
  "composeFiles": ["docker-compose.cognee.yml"],
  "services": [
    {
      "id": "cognee",
      "label": "Cognee Memory",
      "composeService": "cognee-mcp",
      "surface": "headless",
      "urlEnv": "COGNEE_MCP_URL",
      "portEnv": "COGNEE_MCP_PORT",
      "fallbackPort": 8001,
      "healthPath": "/health",
      "mcpServer": {
        "name": "cognee",
        "transport": "http",
        "path": "/mcp"
      }
    }
  ]
}
